# ─────────────────────────────────────────────────────────────────────────
# Backend environment configuration
# Copy this file to backend/.env and fill in your own values.
# ─────────────────────────────────────────────────────────────────────────

# ── Vertex AI / Gemini (Google Cloud) ─────────────────────────────────────
# Project ID for your Google Cloud / Vertex AI free-tier account.
# Create one at: https://console.cloud.google.com/projectcreate
GEMINI_VERTEX_PROJECT=gen-lang-client-0226029743

# Location / region for Vertex AI inference.
# us-central1 is in the free tier and available globally.
GEMINI_VERTEX_LOCATION=us-central1

# Model name. gemini-2.5-pro is the default; gemini-1.5-flash is cheaper/faster.
GEMINI_MODEL=gemini-2.5-pro

# ── Optional: alternative LLM via OpenAI-compatible API ──────────────────
# If Vertex AI is unavailable, you can fall back to an OpenAI-style endpoint.
# Leave blank to disable.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ── Optional file paths ───────────────────────────────────────────────────
# S2P_PROCESS_PATH=/path/to/S2P_Process_L1_L5_RACI.xlsx
# BPR_NAVIGATOR_PATH=/path/to/PH-BPRNavigator.xlsx
